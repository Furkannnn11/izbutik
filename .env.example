# Sunucu
PORT=3000
NODE_ENV=development

# PostgreSQL bağlantısı
DATABASE_URL=postgres://izbutik:izbutik123@127.0.0.1:5432/izbutik_db

# Alternatif olarak tek tek değişkenler
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=izbutik
PGPASSWORD=izbutik123
PGDATABASE=izbutik_db

# Commerce backend (varsayılan: medusa; geri dönüş için legacy)
COMMERCE_BACKEND=medusa
MEDUSA_BACKEND_URL=http://127.0.0.1:9000
# `cd medusa-backend && npm run seed` çıktısındaki pk_... değeri
MEDUSA_PUBLISHABLE_KEY=pk_replace_with_local_seed_output
