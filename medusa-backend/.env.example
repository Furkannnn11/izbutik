# İzbutik Medusa Backend — ortam değişkeni ŞABLONU (.env.example)
# Bu bir ŞABLONDUR. Gerçek .env dosyasını COMMIT ETME (.gitignore ile hariç tutulur).
# Kullanım: `cp .env.example .env` ve JWT_SECRET/COOKIE_SECRET'i güçlü değerlerle değiştir.

# --- Ortam ---
NODE_ENV=development

# --- Sunucu bind (YALNIZCA loopback) ---
HOST=127.0.0.1
PORT=9000
MEDUSA_BACKEND_URL=http://127.0.0.1:9000

# --- Veritabanı (YALNIZCA izole izbutik_medusa; mevcut izbutik_db'ye DOKUNMA) ---
DATABASE_URL=postgres://izbutik@127.0.0.1:5432/izbutik_medusa

# --- CORS ---
# Mevcut storefront origin'i http://127.0.0.1:3001 Store/Auth CORS'a dahildir.
# 127.0.0.1:8000 = Medusa Next.js starter storefront (opsiyonel yerel geliştirme).
STORE_CORS=http://127.0.0.1:3001,http://127.0.0.1:8000
# 127.0.0.1:9000 = Medusa admin paneli (aynı backend), 7001 = eski admin dev portu.
ADMIN_CORS=http://127.0.0.1:9000,http://127.0.0.1:7001
AUTH_CORS=http://127.0.0.1:3001,http://127.0.0.1:9000

# --- Secret'lar (GERÇEK değerleri commit etme; yerelde güçlü değerlerle değiştir) ---
JWT_SECRET=replace-with-strong-secret
COOKIE_SECRET=replace-with-strong-secret

# --- Worker modu (yerelde tek sunucu için 'shared') ---
MEDUSA_WORKER_MODE=shared

# --- Admin paneli (yerelde açık) ---
MEDUSA_DISABLE_ADMIN=false

# --- Redis (yerelde OPSİYONEL) ---
# REDIS_URL boş bırakılırsa event bus / cache / workflow engine in-memory çalışır.
# Üretim veya çok işlemli yerel kurulum için ayarla:
# REDIS_URL=redis://127.0.0.1:6379
